# 默认：由 Git 判定文本/二进制，文本统一 LF
* text=auto eol=lf

# ===== 二进制资源：禁止换行转换与文本合并 =====
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.skel  binary
*.spine binary
*.ogg   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.res   binary
*.scn   binary

# ===== 文本资源：统一 LF =====
*.cs     text eol=lf
*.tscn   text eol=lf
*.tres   text eol=lf
*.cfg    text eol=lf
*.godot  text eol=lf
*.import text eol=lf
*.atlas  text eol=lf
*.uid    text eol=lf
*.md     text eol=lf
